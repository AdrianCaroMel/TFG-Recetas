<resources>
    <!--
        Tema principal: Material Design 3, sin ActionBar del sistema
        (cada pantalla tiene su propia MaterialToolbar, ver layout/barra_superior.xml).
        Funciona en modo claro y oscuro: los colores cambian en values-night/colors.xml.
    -->
    <style name="Theme.TFGRecetas" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verde</item>
        <item name="colorOnPrimary">@color/sobre_verde</item>
        <item name="colorPrimaryContainer">@color/verde_claro</item>
        <item name="colorOnPrimaryContainer">@color/verde_oscuro</item>
        <item name="colorSecondary">@color/naranja</item>
        <item name="colorOnSecondary">@color/sobre_naranja</item>
        <item name="colorSecondaryContainer">@color/naranja_claro</item>
        <item name="colorOnSecondaryContainer">@color/sobre_naranja_claro</item>
        <item name="colorError">@color/rojo_aviso</item>
        <item name="colorErrorContainer">@color/rojo_claro</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorSurfaceVariant">@color/fondo_tarjeta</item>
        <item name="colorOutline">@color/borde</item>
        <item name="colorOutlineVariant">@color/borde</item>
        <item name="colorSurfaceContainerLow">@color/superficie</item>
        <item name="colorSurfaceContainer">@color/superficie</item>
        <item name="colorSurfaceContainerHigh">@color/superficie</item>

        <!-- La app dibuja detras de las barras del sistema (edge-to-edge) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="materialCardViewStyle">@style/Tarjeta</item>
        <item name="materialButtonStyle">@style/Boton</item>
    </style>

    <!-- Colores de los iconos y textos de la barra superior verde -->
    <style name="ThemeOverlay.TFGRecetas.BarraSuperior" parent="">
        <item name="colorControlNormal">@color/sobre_verde</item>
        <item name="colorOnSurface">@color/sobre_verde</item>
        <item name="colorOnSurfaceVariant">@color/sobre_verde</item>
    </style>

    <!-- ===== Componentes ===== -->

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tarjeta resaltada (resumen del gasto, estimacion...) -->
    <style name="Tarjeta.Destacada">
        <item name="cardBackgroundColor">@color/verde_claro</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Tarjeta.Aviso">
        <item name="cardBackgroundColor">@color/rojo_claro</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Boton" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Boton.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Boton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Barra inferior con el boton principal de cada pantalla -->
    <style name="BarraInferior">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/superficie</item>
        <item name="android:elevation">8dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- ===== Textos ===== -->

    <style name="Texto.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Seccion" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/verde</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="Texto.Secundario" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/naranja</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
