<?xml version="1.0" encoding="utf-8"?>
<!--
    Modo cocina: un paso cada vez, con letra grande, temporizador y la pantalla siempre encendida.
    Pensado para usarse con las manos ocupadas: botones grandes abajo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/degradado_cocina"
    android:orientation="vertical">

    <include layout="@layout/barra_superior" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvPasoCocina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/Texto.Etiqueta"
            android:textColor="@color/cta" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresoCocina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:indicatorColor="@color/cta"
            app:trackColor="#33FFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaPaso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvNumeroGrande"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/fondo_numero"
                        android:gravity="center"
                        android:textColor="@color/verde_oscuro"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTextoCocina"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="22sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <!-- Temporizador: solo aparece si el paso dice un tiempo -->
        <LinearLayout
            android:id="@+id/zonaTemporizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/circuloTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="1000"
                    app:indicatorColor="@color/cta"
                    app:indicatorSize="96dp"
                    app:trackColor="#33FFFFFF"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tvTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/sobre_degradado"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAyudaTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cocina_temporizador"
                    android:textColor="@color/sobre_degradado"
                    android:alpha="0.85" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTemporizador"
                    style="@style/Boton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/cta"
                    android:textColor="@color/sobre_cta" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnterior"
            style="@style/Boton.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cocina_anterior"
            android:textColor="@color/sobre_degradado"
            app:strokeColor="#99FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguiente"
            style="@style/Boton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1.4"
            android:backgroundTint="@color/cta"
            android:textColor="@color/sobre_cta" />
    </LinearLayout>
</LinearLayout>
