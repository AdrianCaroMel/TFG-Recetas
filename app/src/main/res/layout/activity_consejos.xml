<?xml version="1.0" encoding="utf-8"?>
<!-- Consejos basicos de cocina para quien empieza (las tarjetas se crean desde Java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorConsejos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/lista_cascada"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/consejos_intro"
                android:textAppearance="@style/Texto.Cuerpo" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
