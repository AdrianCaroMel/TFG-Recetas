<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador "Paso X de 3" de los pasos del formulario inicial -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tvPaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAppearance="@style/Texto.Etiqueta" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresoPasos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="3"
        app:indicatorColor="@color/verde"
        app:trackColor="@color/verde_claro"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />
</LinearLayout>
