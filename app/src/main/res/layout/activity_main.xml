<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_circulo"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/bienvenida_titulo"
                android:textAppearance="@style/Texto.Titulo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/bienvenida_texto"
                android:textAppearance="@style/Texto.Secundario"
                android:textSize="16sp" />

            <!-- Como funciona: tres pasos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include
                        android:id="@+id/paso1"
                        layout="@layout/item_paso" />

                    <include
                        android:id="@+id/paso2"
                        layout="@layout/item_paso" />

                    <include
                        android:id="@+id/paso3"
                        layout="@layout/item_paso" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Resumen de los datos guardados (solo si ya los ha rellenado) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerfil"
                style="@style/Tarjeta.Destacada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tu_perfil"
                        android:textAppearance="@style/Texto.Seccion" />

                    <TextView
                        android:id="@+id/tvPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:textAppearance="@style/Texto.Cuerpo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        style="@style/BarraInferior"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empezar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarDatos"
            style="@style/Boton.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cambiar_datos"
            android:visibility="gone"
            app:icon="@drawable/ic_editar"
            app:iconGravity="textStart" />
    </LinearLayout>

</LinearLayout>
