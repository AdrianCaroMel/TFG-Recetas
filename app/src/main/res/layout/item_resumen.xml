<?xml version="1.0" encoding="utf-8"?>
<!-- Primera fila del plan: cuanto se gasta y cuanto sobra -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Tarjeta.Destacada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gasto_del_mes"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/verde_oscuro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGasto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                    android:textColor="@color/verde_oscuro"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPresupuesto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/verde_oscuro" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/barraGasto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                app:indicatorColor="@color/verde"
                app:trackColor="@color/superficie"
                app:trackCornerRadius="5dp"
                app:trackThickness="10dp" />

            <TextView
                android:id="@+id/tvSobrante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/Texto.Cuerpo" />

            <TextView
                android:id="@+id/tvDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/Texto.Secundario" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Aviso si el presupuesto no llega o no hay recetas -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAviso"
        style="@style/Tarjeta.Aviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/rojo_aviso"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
