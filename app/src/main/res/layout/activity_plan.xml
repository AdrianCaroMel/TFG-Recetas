<?xml version="1.0" encoding="utf-8"?>
<!-- Plan del mes: resumen del gasto + dias (todo dentro de la lista, ver PlanAdapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/barra_superior" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/lista_cascada"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />

    <LinearLayout style="@style/BarraInferior">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListaCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_lista_compra"
            app:icon="@drawable/ic_carrito"
            app:iconGravity="textStart" />
    </LinearLayout>

</LinearLayout>
