<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de una receta: datos, ingredientes y pasos (filas creadas desde Java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/lista_cascada"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Emoji grande de la receta (entra con un rebote) -->
            <TextView
                android:id="@+id/tvEmojiGrande"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/fondo_emoji"
                android:elevation="4dp"
                android:gravity="center"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/tvNombreReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texto.Titulo" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp" />

            <!-- Informacion nutricional de una racion -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta.Destacada"
        app:cardElevation="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:background="@drawable/degradado_verde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/por_racion_titulo"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/sobre_degradado" />

                    <TextView
                        android:id="@+id/tvKcal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textColor="@color/sobre_degradado"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMacros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/Texto.Cuerpo"
                android:textColor="@color/sobre_degradado" />

                    <TextView
                        android:id="@+id/tvRacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="@style/Texto.Secundario"
                android:alpha="0.9"
                android:textColor="@color/sobre_degradado" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/contenedorIngredientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/ingredientes"
                        android:textAppearance="@style/Texto.Seccion" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/contenedorPasos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/preparacion"
                        android:textAppearance="@style/Texto.Seccion" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/BarraInferior">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCocina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/cta"
            android:text="@string/modo_cocina"
            android:textColor="@color/sobre_cta" />
    </LinearLayout>

</LinearLayout>
